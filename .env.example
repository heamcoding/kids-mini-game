# copy to .env (never commit .env)
POSTGRES_DB=kidsminigame
POSTGRES_USER=kids
POSTGRES_PASSWORD=change-me
# Build-time: baked into the frontend bundle; must be reachable from the BROWSER
VITE_SPRING_URL=http://localhost:8080
VITE_FASTAPI_URL=http://localhost:8000
# Browser origins allowed to call both APIs (comma-separated). Set to your real frontend URL in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
