# copy to .env (never commit .env)
POSTGRES_DB=kidsminigame
POSTGRES_USER=kids
POSTGRES_PASSWORD=change-me
# Optional, build-time: leave empty to call the same origin (nginx proxies /api/*).
# Only set it if the API is hosted on a different origin than the frontend.
VITE_API_URL=
# Browser origins allowed to call both APIs (comma-separated). Set to your real frontend URL in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
